PORT=3000
DATABASE_URL=postgres://madd:madd_dev_only@localhost:5433/madd
JWT_SECRET=replace-with-a-long-random-string
TEST_DATABASE_URL=postgres://madd:madd_dev_only@localhost:5433/madd_test
# Admin account for `npm run db:seed-admin`. Type the real values into .env yourself.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_PHONE=
# Firebase service-account key file for push alerts (task D7), e.g. ./secrets/firebase.json. Leave empty to switch push off.
FIREBASE_SERVICE_ACCOUNT=
